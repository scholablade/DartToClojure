(ns verify.checks
  "Runtime checks for the corpus translations compiled by this project.

  `verify.gen.m3` is the dart2cljd translation of `corpus/m3.dart`; these tests
  assert the translated code behaves like the Dart original at runtime,
  including the async path. They run under `flutter test`, driven by the one
  `clj -M:cljd test verify.checks` invocation of the gate (see `make verify`).

  `verify.main` is required, without an alias, so that same invocation also
  compiles every generated corpus namespace (main requires them all). Test
  namespaces are renamed by the compiler, which leaves bogus imports in the
  generated `lib/` Dart; the harness strips those before `dart analyze`
  (RESEARCH M5.6)."
  (:require [cljd.test :refer [deftest is]]
            [verify.main]
            [verify.gen.m3 :as g]
            [verify.gen.idiomatic :as i]
            [verify.gen.batchproj.main :as bp]
            [verify.gen.batchproj.models.item :as item]
            ["package:flutter/material.dart" :as m]
            ["package:flutter_test/flutter_test.dart" :as ft]))

(deftest fib
  (is (= 5 (g/fib 5)))
  (is (= 0 (g/fib 0)))
  (is (= 1 (g/fib 2))))

(deftest operators
  (let [p (g/Point-new 1 2)
        q (g/Point-make 1)]
    (is (= "Point(1.0, 2.0)" (str p)))
    (is (= "Point(2.0, 3.0)" (str (. p + q))))
    (is (= "Point(-1.0, -2.0)" (str (.unary- p))))))

(deftest fields-and-setters
  (let [p (g/Point-new 1 2)]
    (.-x! p 3)
    (.-norm! p 4)
    (is (= 4.0 (.-x p)))
    (is (= 32.0 (.-norm p)))
    (is (= "Point(4.0, 4.0)" (str p)))))

(deftest statics-and-enums
  (is (= "Point(0.0, 0.0)" (str g/Point-zero)))
  (is (= "Point(3.0, 3.0)" (str (g/Point-make 3))))
  (is (= "red" (.-name g/Color-red)))
  (is (= 0 (.-index g/Color-red)))
  (is (= 2 (.-value g/Suit-hearts)))
  (is (= 3 (count g/Color-values)))
  (is (= 1 g/oldName)))

(deftest loops
  (g/loops))

(deftest dynamic-operator-dispatch
  (is (= "Point(3.0, 3.0)"
         (str (g/addAny (g/Point-make 1) (g/Point-make 2))))))

(deftest in-file-statics
  (is (= "0/0" (g/Usage-summary)))
  (g/Usage-record 2)
  (is (= "2/2" (g/Usage-summary)))
  (is (= 2 g/Usage-hits))
  (g/setTotal 7)
  (is (= "7/7" (g/Usage-summary)))
  (g/set-total! 9)
  (is (= 9 (g/Usage-total))))

(deftest async-work
  (is (= 6 (await (g/work 5)))))

;; ---------------------------------------------------------------------------
;; batch directory conversion runtime (test/batchproj translation, M6)
;;
;; `verify.gen.batchproj.main` is the generated `test/batchproj/lib/main.dart`
;; of the manifest's `:kind :dir` entry; its imports are symbol requires into
;; the other generated files, so these checks exercise the cross-file paths
;; (constructor make-fns, statics, type references) at runtime.
;; ---------------------------------------------------------------------------

(deftest cross-file-project
  (is (= "Button[b]: widget (3.5)" (bp/describe (item/Item-new "widget" 3.5))))
  (is (= "item: box" (bp/describeKind)))
  (is (= 5.0 (bp/hyp 3.0 4.0)))
  (is (= "a+b" (bp/mergeBoxes))))

(deftest cross-file-values-and-statics
  (bp/resetCounts)
  (is (= "x:0" (bp/tagOf (item/Item-new "x" 1.0))))
  (is (= "1/2/2" (bp/touch)))
  (is (= "x:1" (bp/tagOf (item/Item-new "x" 1.0))))
  (is (= 2 (item/Item-total)))
  (item/set-total! 9)
  (is (= 9 (item/Item-total)))
  (is (= 9 item/Item-count)))

;; ---------------------------------------------------------------------------
;; idiomatic widget runtime (corpus/idiomatic.dart translation)
;; ---------------------------------------------------------------------------

(deftest key-params-are-threaded
  :runner (ft/testWidgets [tester])
  (let [^ft/WidgetTester {:flds [pumpWidget]} tester]
    (await (pumpWidget (m/MaterialApp .home (i/Greeting .key (m/ValueKey "g1")
                                                      .name "Ada"))))
    (ft/expect (ft/find.text "Hello Ada") ft/findsOneWidget)))

(deftest set-state-without-state-write-rebuilds
  :runner (ft/testWidgets [tester])
  (let [^ft/WidgetTester {:flds [pumpWidget tap pump]} tester]
    (await (pumpWidget (m/MaterialApp .home (i/Ticker .key (m/ValueKey "t1")))))
    (ft/expect (ft/find.text "ticks: 0") ft/findsOneWidget)
    (await (tap (ft/find.byType m/TextButton)))
    (await (pump))
    (ft/expect (ft/find.text "ticks: 1") ft/findsOneWidget)))

(deftest managed-controller-lifecycle
  :runner (ft/testWidgets [tester])
  (let [^ft/WidgetTester {:flds [pumpWidget enterText]} tester]
    (await (pumpWidget (m/MaterialApp .home (m/Scaffold .body (i/Editor)))))
    (ft/expect (ft/find.text "hi") ft/findsOneWidget)
    (await (enterText (ft/find.byType m/TextField) "bye"))
    (ft/expect (ft/find.text "bye") ft/findsOneWidget)
    (await (pumpWidget (m/MaterialApp .home (m/SizedBox))))))

(deftest managed-vsync-lifecycle
  :runner (ft/testWidgets [tester])
  (let [^ft/WidgetTester {:flds [pumpWidget]} tester]
    (await (pumpWidget (m/MaterialApp .home (i/Fader))))
    (ft/expect (ft/find.text "fade") ft/findsOneWidget)
    (await (pumpWidget (m/MaterialApp .home (m/SizedBox))))))

;; ---------------------------------------------------------------------------
;; M8: mixins with fields (inlined into appliers) and collection splicing
;; ---------------------------------------------------------------------------

(deftest mixins-with-fields
  (let [t (g/TaggedItem-new "x")]
    (is (= "x tag:false" (.describe t)))
    (.activate t)
    (is (= "x tag:true" (.describe t))))
  (let [b (g/CountedBox-new "c")]
    (.bump b)
    (.bump b)
    (is (= "c=2" (.renderCount b)))))

(deftest collection-elements
  (is (= [0 2 4 100 200 7 8] (g/collect 3 true [7] nil)))
  (is (= [0 2 4 300 7 8] (g/collect 3 false [7] nil)))
  (is (= [0 2 4 100 200 7 8 5] (g/collect 3 true [7] 5))))

(deftest statement-for-shapes
  (is (= 6 (g/countUp 4)))
  (is (= "0-4;1-3;" (g/multiVar 4))))

;; ---------------------------------------------------------------------------
;; M8: cross-file mixin + barrel with project and external exports
;; ---------------------------------------------------------------------------

(deftest cross-file-mixin-and-barrel
  (is (= "L:x:true" (bp/badgeText "x")))
  (is (= "x" (.-data (bp/makeLabel "x")))))

(deftest parts-are-merged-into-their-library
  (let [i (item/Item-new "p" 2.0)]
    (is (= "p#2.0" (bp/describeTag i)))
    (is (= "p#2.0" (item/tagLine i)))
    (is (= "[p]" (bp/itemTag i)))
    (is (= "meta" (bp/itemMeta i)))
    (is (= "[z]" (bp/makeTag "z")))
    (is (= "item:name" (bp/declaredName "name")))))

(deftest enum-named-arguments
  (is (= "b" (.-id g/Rank-bronze)))
  (is (= "Gold" (.-name g/Rank-gold)))
  (is (= 1 (.-index g/Rank-gold)))
  (is (= 3 (.-weight g/Rank-gold)))
  (is (= 2 (count g/Rank-values))))

(deftest constructor-body-field-writes
  (is (= 4 (.-count (g/CtorBody-new)))))

(deftest same-file-top-level-value
  (is (= "motto" (bp/motto))))

(deftest closure-field-access
  (let [c (g/ClosureField-new)
        read (.reader c)
        write (.writer c)]
    (is (= 0 (read)))
    (write)
    (is (= 5 (read)))))

(deftest late-fields
  (let [l (g/LateField-new)]
    (.setIt l 7)
    (is (= 7 (.readIt l)))))

(deftest late-final-fields
  (let [l (g/LateFinal-new 3)]
    (is (= 3 (.-fromCtor l)))
    (.init l)
    (is (= 10 (.sum l)))))

(deftest late-init-fields
  (let [l (g/LateInit-new 3)]
    (is (= 3 (.-start l)))
    (is (= 6 (.-doubled l)))
    (is (identical? l (.-self l)))))

(deftest private-types-are-renamed
  (is (= 14 (g/privateBoxSum 7))))

(deftest non-const-defaults
  (is (= 3 (g/defaultSum)))
  (is (= 5 (g/defaultSum .xs [9 9] .add 3)))
  (let [d (g/Defaults-new)]
    (is (= 3 (.total d))))
  (let [d (g/Defaults-new .values [7 7 7] .label "ab")]
    (is (= 5 (.total d)))))

(deftest void-callback-closures
  (let [h (g/VoidCallbackHost-new)]
    (.bump h)
    (is (= 1 (.-value h)))))

(deftest reserved-local-names
  (let [h (g/ShadowHost-new)]
    (is (= 8 (.run h 1 2)))))

;; ---------------------------------------------------------------------------
;; M8.18: parameter scoping, loop-var types, value tails, await locals
;; ---------------------------------------------------------------------------

(deftest field-shadowing-parameters
  (let [s (g/ShadowField-new "boom")]
    (is (= "boom!" (.describe s (fn [e] (str e "!")))))))

(deftest generic-constructor-parameters
  (is (= 3 (g/holderLength)))
  (is (= 7 (.-value (g/Holder-named 7)))))

(deftest local-base-override-parameters
  (is (= "hi NarrowGreeter" (g/narrowGreet))))

(deftest loop-var-types
  (is (true? (g/loopVarEven 3)))
  (is (= 3 (g/tripleDiv 12 2 2))))

(deftest value-tail-discard
  (let [seen (volatile! nil)]
    (g/schedule 5 (fn [n] (vreset! seen n)))
    (is (= 5 (deref seen)))))

(deftest await-init-locals
  (is (= 3 (await (g/awaitLocal 1)))))

(deftest nested-closure-control-flow
  (is (= 6 (g/guardedClosure 3)))
  (is (= 0 (g/guardedClosure -1))))

;; ---------------------------------------------------------------------------
;; M10: String concatenation and closure mutation
;; ---------------------------------------------------------------------------

(deftest string-concatenation
  (is (= "hi!?2even" (g/stringOps "hi" 2)))
  (is (= "hi!?3odd" (g/stringOps "hi" 3)))
  (let [h (g/StringHost-new "Z")]
    (is (= "aZ" (.-label h)))
    (.bump h)
    (is (= "aZ!?" (.-label h)))
    (is (= 1 (.-count h)))
    (is (= "aZ!?:1" (.describe h)))))

(deftest closure-mutation-visibility
  (is (= 7 (g/closureMut 3)))
  (is (= "xy" (g/closureString))))

(deftest string-state-concatenation
  :runner (ft/testWidgets [tester])
  (let [^ft/WidgetTester {:flds [pumpWidget tap pump]} tester]
    (await (pumpWidget (m/MaterialApp .home (i/Typer))))
    (ft/expect (ft/find.text "a!") ft/findsOneWidget)
    (await (tap (ft/find.byType m/TextButton)))
    (await (pump))
    (ft/expect (ft/find.text "ab!") ft/findsOneWidget)))
