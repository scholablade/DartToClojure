(ns verify.checks
  "Runtime checks for the corpus translations compiled by this project.

  `verify.gen.m3` is the dart2cljd translation of `corpus/m3.dart`; these tests
  assert the translated code behaves like the Dart original at runtime,
  including the async path. They run under `flutter test`, driven by the one
  `clj -M:cljd test verify.checks` invocation of the gate (see `make verify`).

  `verify.main` is required, without an alias, so that same invocation also
  compiles every generated corpus namespace (main requires them all). Test
  namespaces are renamed by the compiler, which leaves bogus imports in the
  generated `lib/` Dart; the harness strips those before `dart analyze`
  (RESEARCH M5.6)."
  (:require [cljd.test :refer [deftest is]]
            [verify.main]
            [verify.gen.m3 :as g]
            [verify.gen.idiomatic :as i]
            [verify.gen.batchproj.main :as bp]
            [verify.gen.batchproj.models.item :as item]
            ["package:flutter/material.dart" :as m]
            ["package:flutter_test/flutter_test.dart" :as ft]))

(deftest fib
  (is (= 5 (g/fib 5)))
  (is (= 0 (g/fib 0)))
  (is (= 1 (g/fib 2))))

(deftest operators
  (let [p (g/Point-new 1 2)
        q (g/Point-make 1)]
    (is (= "Point(1.0, 2.0)" (str p)))
    (is (= "Point(2.0, 3.0)" (str (. p + q))))
    (is (= "Point(-1.0, -2.0)" (str (.unary- p))))))

(deftest fields-and-setters
  (let [p (g/Point-new 1 2)]
    (.-x! p 3)
    (.-norm! p 4)
    (is (= 4.0 (.-x p)))
    (is (= 32.0 (.-norm p)))
    (is (= "Point(4.0, 4.0)" (str p)))))

(deftest statics-and-enums
  (is (= "Point(0.0, 0.0)" (str g/Point-zero)))
  (is (= "Point(3.0, 3.0)" (str (g/Point-make 3))))
  (is (= "red" (.-name g/Color-red)))
  (is (= 0 (.-index g/Color-red)))
  (is (= 2 (.-value g/Suit-hearts)))
  (is (= 3 (count g/Color-values)))
  (is (= 1 g/oldName)))

(deftest loops
  (g/loops))

(deftest dynamic-operator-dispatch
  (is (= "Point(3.0, 3.0)"
         (str (g/addAny (g/Point-make 1) (g/Point-make 2))))))

(deftest in-file-statics
  (is (= "0/0" (g/Usage-summary)))
  (g/Usage-record 2)
  (is (= "2/2" (g/Usage-summary)))
  (is (= 2 g/Usage-hits))
  (g/setTotal 7)
  (is (= "7/7" (g/Usage-summary)))
  (g/set-total! 9)
  (is (= 9 (g/Usage-total))))

(deftest async-work
  (is (= 6 (await (g/work 5)))))

;; ---------------------------------------------------------------------------
;; batch directory conversion runtime (test/batchproj translation, M6)
;;
;; `verify.gen.batchproj.main` is the generated `test/batchproj/lib/main.dart`
;; of the manifest's `:kind :dir` entry; its imports are symbol requires into
;; the other generated files, so these checks exercise the cross-file paths
;; (constructor make-fns, statics, type references) at runtime.
;; ---------------------------------------------------------------------------

(deftest cross-file-project
  (is (= "Button[b]: widget (3.5)" (bp/describe (item/Item-new "widget" 3.5))))
  (is (= "item: box" (bp/describeKind)))
  (is (= 5.0 (bp/hyp 3.0 4.0))))

(deftest cross-file-values-and-statics
  (bp/resetCounts)
  (is (= "x:0" (bp/tagOf (item/Item-new "x" 1.0))))
  (is (= "1/2/2" (bp/touch)))
  (is (= "x:1" (bp/tagOf (item/Item-new "x" 1.0))))
  (is (= 2 (item/Item-total)))
  (item/set-total! 9)
  (is (= 9 (item/Item-total)))
  (is (= 9 item/Item-count)))

;; ---------------------------------------------------------------------------
;; idiomatic widget runtime (corpus/idiomatic.dart translation)
;; ---------------------------------------------------------------------------

(deftest key-params-are-threaded
  :runner (ft/testWidgets [tester])
  (let [^ft/WidgetTester {:flds [pumpWidget]} tester]
    (await (pumpWidget (m/MaterialApp .home (i/Greeting .key (m/ValueKey "g1")
                                                      .name "Ada"))))
    (ft/expect (ft/find.text "Hello Ada") ft/findsOneWidget)))

(deftest set-state-without-state-write-rebuilds
  :runner (ft/testWidgets [tester])
  (let [^ft/WidgetTester {:flds [pumpWidget tap pump]} tester]
    (await (pumpWidget (m/MaterialApp .home (i/Ticker .key (m/ValueKey "t1")))))
    (ft/expect (ft/find.text "ticks: 0") ft/findsOneWidget)
    (await (tap (ft/find.byType m/TextButton)))
    (await (pump))
    (ft/expect (ft/find.text "ticks: 1") ft/findsOneWidget)))

(deftest managed-controller-lifecycle
  :runner (ft/testWidgets [tester])
  (let [^ft/WidgetTester {:flds [pumpWidget enterText]} tester]
    (await (pumpWidget (m/MaterialApp .home (m/Scaffold .body (i/Editor)))))
    (ft/expect (ft/find.text "hi") ft/findsOneWidget)
    (await (enterText (ft/find.byType m/TextField) "bye"))
    (ft/expect (ft/find.text "bye") ft/findsOneWidget)
    (await (pumpWidget (m/MaterialApp .home (m/SizedBox))))))

(deftest managed-vsync-lifecycle
  :runner (ft/testWidgets [tester])
  (let [^ft/WidgetTester {:flds [pumpWidget]} tester]
    (await (pumpWidget (m/MaterialApp .home (i/Fader))))
    (ft/expect (ft/find.text "fade") ft/findsOneWidget)
    (await (pumpWidget (m/MaterialApp .home (m/SizedBox))))))
