(deftype Color
  [^String name ^int index]
  :type-only true
  Color)

(def Color-red (Color "red" 0))

(def Color-green (Color "green" 1))

(def Color-blue (Color "blue" 2))

(def Color-values [Color-red Color-green Color-blue])

(deftype Suit
  [^String name ^int index ^int value]
  :type-only true
  Suit)

(def Suit-hearts (let [value 2] (Suit "hearts" 0 value)))

(def Suit-spades (let [value 11] (Suit "spades" 1 value)))

(def Suit-values [Suit-hearts Suit-spades])

(deftype Rank
  [^int index ^String id ^String name ^int weight]
  :type-only true
  Rank)

(def Rank-bronze (let [id "b" name "Bronze" weight 1] (Rank 0 id name weight)))

(def Rank-gold (let [id "g" name "Gold" weight 3] (Rank 1 id name weight)))

(def Rank-values [Rank-bronze Rank-gold])

(deftype Usage
  []
  :type-only true
  Usage)

(defn ^Usage Usage-new []
  (let [this (Usage)] this))

(def Usage-hits 0)

(defn Usage-total []
  Usage-hits)

(defn set-total! [^int v]
  (set! Usage-hits v)
  nil)

(defn Usage-record [^int n]
  (set! Usage-hits (+ Usage-hits n))
  nil)

(defn Usage-summary []
  (str Usage-hits "/" (Usage-total)))

(defn setTotal [^int v]
  (set-total! v)
  nil)

(comment "typedef Cb (expanded at use sites)")

(comment "typedef Pair (expanded at use sites)")

(defn fib [^int n]
  (let [d2c$result (volatile! nil)
        d2c$done (volatile! false)]
    (do
      (when (not (deref d2c$done))
        (when (< n 2)
          (when (not (deref d2c$done)) (do (vreset! d2c$result n) (vreset! d2c$done true)))))
      (when (not (deref d2c$done))
        (do (vreset! d2c$result (+ (fib (- n 1)) (fib (- n 2)))) (vreset! d2c$done true))))
    (deref d2c$result)))

(defn addAny [a b]
  (let [d2c$a a
        d2c$b b]
    (if (and (dart/is? d2c$a Point) (dart/is? d2c$b Point)) (. d2c$a + d2c$b) (+ d2c$a d2c$b))))

(deftype ^:mixin Tagged
  [^String prefix ^:mutable ^bool _active]
  :type-only true
  Tagged
  (^:getter ^String tag [this] (str prefix ":" _active))
  (^void activate [this] (set! _active true) nil))

(deftype TaggedItem
  [^String name ^String prefix ^:mutable ^bool _active]
  :type-only true
  Tagged
  TaggedItem
  (^String describe [this] (str name " " (.-tag this)))
  (^:getter ^String tag [this] (str prefix ":" _active))
  (^void activate [this] (set! _active true) nil))

(defn ^TaggedItem TaggedItem-new [^String name]
  (let [prefix "tag" _active false this (TaggedItem name prefix _active)] this))

(deftype ^:mixin ^{:type-params [T]} Counted
  [^:mutable ^int _count]
  :type-only true
  Counted
  (^:getter ^int count [this] _count)
  (^void bump [this] (set! _count (inc _count)) nil))

(deftype CountedBox
  [^String label ^:mutable ^int _count]
  :type-only true
  ^{:type-params [String]} Counted
  CountedBox
  (^String renderCount [this] (str label "=" (.-count this)))
  (^:getter ^int count [this] _count)
  (^void bump [this] (set! _count (inc _count)) nil))

(defn ^CountedBox CountedBox-new [^String label]
  (let [_count 0 this (CountedBox label _count)] this))

(defn collect [^int n ^bool flag extra maybe]
  (vec
    (concat
      (loop [^int i 0
             d2c$acc []]
        (if (< i n) (let [d2c$seg [(* i 2)]] (recur (inc i) (into d2c$acc d2c$seg))) d2c$acc))
      (if flag [100 200] [300])
      (mapcat
        (fn [x]
          [x
           (let [d2c$a x
                 d2c$b 1]
             (if (and (dart/is? d2c$a Point) (dart/is? d2c$b Point))
               (. d2c$a + d2c$b)
               (+ d2c$a d2c$b)))])
        extra)
      (if (nil? maybe) [] [maybe]))))

(defn countUp [^int n]
  (let [total (volatile! 0)]
    (loop [^int i 0] (when (< i n) (vswap! total + i) (recur (inc i))))
    (deref total)))

(defn multiVar [^int n]
  (let [out (volatile! "")]
    (loop [^int i 0
           j n]
      (when (< i j) (vreset! out (str (deref out) i "-" j ";")) (recur (inc i) (dec j))))
    (deref out)))

(defn loops []
  (let [sum (volatile! 0)]
    (let [d2c$brk (volatile! false)
          d2c$cont (volatile! false)]
      (loop [^int i 0]
        (vreset! d2c$cont false)
        (when (and (not (or (deref d2c$brk) (deref d2c$cont))) (< i 10))
          (do
            (when (not (or (deref d2c$brk) (deref d2c$cont)))
              (when (= i 3)
                (when (not (or (deref d2c$brk) (deref d2c$cont))) (vreset! d2c$cont true))))
            (do
              (when (not (or (deref d2c$brk) (deref d2c$cont)))
                (when (= i 8)
                  (when (not (or (deref d2c$brk) (deref d2c$cont))) (vreset! d2c$brk true))))
              (when (not (or (deref d2c$brk) (deref d2c$cont))) (vswap! sum + i))))
          (when (not (deref d2c$brk)) (recur (inc i))))))
    (loop [] (when (> (deref sum) 0) (vswap! sum dec) (recur)))
    (loop [] (vswap! sum + 2) (when (< (deref sum) 0) (recur)))
    (let [d2c$brk$outer (volatile! false)
          d2c$cont$outer (volatile! false)]
      (loop [d2c$seq (seq [1 2 3])]
        (vreset! d2c$cont$outer false)
        (when (and (not (or (deref d2c$brk$outer) (deref d2c$cont$outer))) d2c$seq)
          (let [x (first d2c$seq)]
            (when (not (or (deref d2c$brk$outer) (deref d2c$cont$outer)))
              (loop [d2c$seq (seq [1 2])]
                (when (and (not (or (deref d2c$brk$outer) (deref d2c$cont$outer))) d2c$seq)
                  (let [y (first d2c$seq)]
                    (do
                      (when (not (or (deref d2c$brk$outer) (deref d2c$cont$outer)))
                        (when (= y 1)
                          (when (not (or (deref d2c$brk$outer) (deref d2c$cont$outer)))
                            (vreset! d2c$cont$outer true))))
                      (when (not (or (deref d2c$brk$outer) (deref d2c$cont$outer)))
                        (vreset! d2c$brk$outer true)))
                    (when (not (or (deref d2c$brk$outer) (deref d2c$cont$outer)))
                      (recur (next d2c$seq)))))))
            (when (not (deref d2c$brk$outer)) (recur (next d2c$seq)))))))
    (let [list [1 2 3]]
      (let [d2c$subj list]
        (cond
          (and (dart/is? d2c$subj List) (<= 1 (count d2c$subj)) (dart/is? (get d2c$subj 0) int))
            (let [a (volatile! (get d2c$subj 0))
                  rest (into [] (drop 1 d2c$subj))]
              (do (print (deref a)) (print rest)))
          (and (dart/is? d2c$subj Map) (contains? d2c$subj "k") (dart/is? (get d2c$subj "k") int))
            (let [v (get d2c$subj "k")] (print v))
          (and (dart/is? d2c$subj Record) (dart/is? (.-$1 (cljd.core/identity d2c$subj)) int) (dart/is? (.-$2 (cljd.core/identity d2c$subj)) String))
            (let [x (.-$1 (cljd.core/identity d2c$subj))
                  y (.-$2 (cljd.core/identity d2c$subj))]
              (if (> x 0) (print y) nil))
          :else (print "none")))
      (let [sw
              (let [d2c$subj (deref sum)]
                (cond
                  (and (= d2c$subj 0)) "zero"
                  (and (dart/is? d2c$subj int)) (let [n d2c$subj] (if (> n 0) "pos" nil))
                  :else "neg"))]
        (print sw)
        (let [d2c$pat #dart (1 2)
              a (volatile! (.-$1 (cljd.core/identity d2c$pat)))
              b (volatile! (.-$2 (cljd.core/identity d2c$pat)))]
          (let [d2c$pat (cljd.core/identity #dart ((deref b) (deref a)))]
            (do
              (vreset! a (.-$1 (cljd.core/identity d2c$pat)))
              (vreset! b (.-$2 (cljd.core/identity d2c$pat)))))
          (print (str (deref a) " " (deref b)))
          nil)))))

(defn ^:async work [^int x]
  (await (Future.delayed (Duration .seconds 1)))
  (+ x 1))

(defn runCallback [cb]
  (cb))

(defn schedule [^int n report]
  (runCallback (let [d2c$cb0 (fn [] (when (> n 0) (do (report n) nil)))] d2c$cb0))
  nil)

(defn ^:async delayedValue [^int x]
  (let [d2c$a x
        d2c$b 1]
    (if (and (dart/is? d2c$a Point) (dart/is? d2c$b Point)) (. d2c$a + d2c$b) (+ d2c$a d2c$b))))

(defn ^:async awaitLocal [^int x]
  (let [value (cljd.core/identity (await (delayedValue x)))]
    (let [d2c$a value
          d2c$b 1]
      (if (and (dart/is? d2c$a Point) (dart/is? d2c$b Point)) (. d2c$a + d2c$b) (+ d2c$a d2c$b)))))

(defn guardedClosure [^int n]
  (let [d2c$result (volatile! nil)
        d2c$done (volatile! false)]
    (do
      (when (not (deref d2c$done))
        (when (< n 0)
          (when (not (deref d2c$done)) (do (vreset! d2c$result 0) (vreset! d2c$done true)))))
      (when (not (deref d2c$done))
        (let [f (fn [] (* n 2))]
          (when (not (deref d2c$done)) (do (vreset! d2c$result (f)) (vreset! d2c$done true))))))
    (deref d2c$result)))

(deftype StringHost
  [^:mutable ^String label ^:mutable ^int count]
  :type-only true
  StringHost
  (^void bump
    [this]
    (.-label! this (str (.-label this) "!"))
    (set! label (str label "?"))
    (set! count (+ count 1))
    nil)
  (^String describe [this] (str label ":" (.toString count))))

(defn ^StringHost StringHost-new [^String start]
  (let [label "a"
        count 0
        this (StringHost label count)]
    (.-label! this (str (.-label this) start))
    nil
    this))

(defn stringOps [^String s ^int n]
  (let [out (volatile! s)]
    (vswap! out str "!")
    (vreset! out (str (deref out) "?" (.toString n)))
    (vswap! out str (if (.-isEven n) "even" "odd"))
    (deref out)))

(defn closureMut [^int n]
  (let [total (atom 0) bump (fn [] (swap! total + n) nil)] (bump) (bump) (+ (deref total) 1)))

(defn closureString []
  (let [out (atom "x") add (fn [] (swap! out str "y") nil)] (add) (deref out)))

^{:dart/annotations ["@Deprecated(\"use newName\")"]} ^:deprecated (def oldName 1)

(deftype ReservedFields
  [^:mutable ^int base ^:mutable ^String tag ^:mutable ^int late]
  :type-only true
  ReservedFields
  (^int readBase [this] base)
  (^int bumpBase [this ^int by] (set! base (+ base by)) base)
  (^int bumpInClosure
    [this ^int by]
    (let [bump (fn [] (.-$base_! this (+ (.-$base_ this) by)) nil)] (bump) base))
  (^String readTag [this] tag)
  (^void appendTag [this ^String s] (set! tag (str tag s)) nil)
  (^int readLate [this] late)
  (^void setLate [this ^int v] (set! late v) nil)
  (^int bumpLate [this] (.-$late_! this (inc (.-late this))) late)
  (^void copyBase [this other] (.-$base_! other (+ base 1)) nil)
  (^void cascade [this] (doto this (.-$base_! 5) (.-$late_! 6)) nil))

(defn ^ReservedFields ReservedFields-new [^int b ^String t ^int l]
  (let [base b
        tag t
        late 0
        this (ReservedFields base tag late)]
    (.-$late_! this l)
    (.-$base_! this (+ (.-$base_ this) 1))
    nil
    this))

(defn main []
  (let [p (Point-new 1 2)]
    (.-x! p 3)
    (.-norm! p 4)
    (print (. p + (Point-make 1)))
    (print Point-zero)
    (print Color-red)
    (print (.-value Suit-hearts))
    (print (fib 5))
    (loops)
    (print oldName)
    (Usage-record 2)
    (print (Usage-summary))
    (setTotal 5)
    (print (Usage-summary))
    nil))
