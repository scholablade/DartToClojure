(deftype ^{:type-params [T]} Holder
  [^T value]
  :type-only true
  Holder)

(defn Holder-new [value]
  (let [this (Holder value)] this))

(defn Holder-named [value]
  (Holder-new value))

(defn holderLength []
  (-> (Holder-new [1 2 3]) .-value .-length))

(deftype Greeter
  []
  :type-only true
  Greeter
  (^String greet [this other] "hi"))

(defn ^Greeter Greeter-new []
  (let [this (Greeter)] this))

(deftype NarrowGreeter
  []
  :type-only true
  :extends Greeter
  NarrowGreeter
  (^String greet [this other] (str "hi " (.-runtimeType other))))

(defn ^NarrowGreeter NarrowGreeter-new []
  (let [this (NarrowGreeter)] this))

(defn narrowGreet []
  (.greet (NarrowGreeter-new) (NarrowGreeter-new)))

(defn loopVarEven [^int n]
  (.-first
    (vec
      (concat
        (loop [^int i 0
               d2c$acc []]
          (if (< i n) (let [d2c$seg [(.-isEven i)]] (recur (inc i) (into d2c$acc d2c$seg))) d2c$acc))))))

(defn tripleDiv [^int a ^int b ^int c]
  (. (. a "~/" b) "~/" c))

(defn coalesce [value ^int fallback]
  (let [d2c$nil value] (if (nil? d2c$nil) fallback d2c$nil)))

(defn coalesceBool [value]
  (let [d2c$nil value] (if (nil? d2c$nil) true d2c$nil)))

(defn coalesceChain [a b ^int fallback]
  (let [d2c$nil (let [d2c$nil a] (if (nil? d2c$nil) b d2c$nil))]
    (if (nil? d2c$nil) fallback d2c$nil)))

(deftype Shape
  [^:mutable ^String label]
  :type-only true
  Shape
