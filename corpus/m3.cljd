(ns m3)

(deftype Point
  [^:mutable ^double x ^:mutable ^double y]
  :type-only true
  Point
  (^:getter ^double norm [this] (+ (* x x) (* y y)))
  (^:setter norm [this ^double v] (set! x v) (set! y v) nil)
  (^Point + [this o] (Point-new (+ x (.-x o)) (+ y (.-y o))))
  (^Point - [this] (Point-new (- x) (- y)))
  (^String toString [this] (str "Point(" x ", " y ")")))

(defn ^Point Point-new [^double x ^double y]
  (let [this (Point x y)] this))

(defn ^Point Point-origin []
  (let [x 0 y 0 this (Point x y)] this))

(def Point-zero (Point-new 0 0))

(defn Point-make [^double v]
  (Point-new v v))

(deftype Base
  [^:mutable ^String name]
  :type-only true
  Base
  (^String greet [this] (str "hi " name)))

(defn ^Base Base-new [^String name]
  (let [this (Base name)] this))

(deftype CtorBody
  [^:mutable ^int count]
  :type-only true
  CtorBody)

(defn ^CtorBody CtorBody-new []
  (let [count 0
        this (CtorBody count)]
    (.-count! this 3)
    (.-count! this (inc (.-count this)))
    nil
    this))

(deftype LateField
  [^:mutable ^int value]
  :type-only true
  LateField
  (^void setIt [this ^int v] (set! value v) nil)
  (^int readIt [this] value))

(defn ^LateField LateField-new []
  (let [value 0 this (LateField value)] this))

(deftype LateFinal
  [^:mutable ^int fromCtor ^:mutable ^int fromMethod]
  :type-only true
  LateFinal
  (^void init [this] (set! fromMethod 7) nil)
  (^int sum [this] (+ fromCtor fromMethod)))

(defn ^LateFinal LateFinal-new [^int v]
  (let [fromCtor 0 fromMethod 0 this (LateFinal fromCtor fromMethod)] (.-fromCtor! this v) nil this))

(deftype d2c_PrivateBox
  [^:mutable ^int value]
  :type-only true
  d2c_PrivateBox
  (^int doubled [this] (* value 2)))

(defn ^d2c_PrivateBox d2c_PrivateBox-new [^int value]
  (let [this (d2c_PrivateBox value)] this))

(defn privateBoxSum [^int v]
  (.doubled (d2c_PrivateBox-new v)))

(deftype Defaults
  [^List values ^String label]
  :type-only true
  Defaults
  (^int total [this] (+ (.-length values) (.-length label))))

(defn ^Defaults Defaults-new [.values nil ^String .label "x"]
  (let [values (if (nil? values) [1 2] values)] (let [this (Defaults values label)] this)))

(defn defaultSum [.xs nil ^int .add 0]
  (let [xs (if (nil? xs) [1 2 3] xs)] (+ (.-length xs) add)))

(deftype VoidCallbackHost
  [^:mutable ^int value]
  :type-only true
  VoidCallbackHost
  (^void run [this cb] (cb) nil)
  (^void bump
    [this]
    (.run this (let [d2c$cb0 (fn [] (.-value! this (+ (.-value this) 1)) nil)] d2c$cb0))
    nil))

(defn ^VoidCallbackHost VoidCallbackHost-new []
  (let [value 0 this (VoidCallbackHost value)] this))

(deftype ShadowHost
  []
  :type-only true
  ShadowHost
  (^num run
    [this ^int let$local ^int when$local]
    (let [and$local (volatile! (+ let$local when$local))]
      (vswap! and$local inc)
      (let [not$local (* (deref and$local) 2)] not$local))))

(defn ^ShadowHost ShadowHost-new []
  (let [this (ShadowHost)] this))

(deftype LateInit
  [^:mutable ^int start ^:mutable ^int doubled ^:mutable self]
  :type-only true
  LateInit)

(defn ^LateInit LateInit-new [^int v]
  (let [start 0
        doubled 0
        self nil
        this (LateInit start doubled self)]
    (.-start! this v)
    nil
    (.-doubled! this (* (.-start this) 2))
    (.-self! this this)
    this))

(deftype ClosureField
  [^:mutable ^int value]
  :type-only true
  ClosureField
  (^Function writer [this] (fn [] (.-value! this 5) nil))
  (^Function reader [this] (fn [] (.-value this))))

(defn ^ClosureField ClosureField-new []
  (let [value 0 this (ClosureField value)] this))

(deftype Child
  [^:mutable ^int n d2c$super0]
  :type-only true
  :extends (Base d2c$super0)
  Child
  (^String greet [this] (str (.greet ^super this) "!")))

(defn ^Child Child-new [^int n ^String name]
